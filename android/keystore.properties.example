# Copy to keystore.properties and fill in. That file is gitignored and must
# stay that way: it points at the key that says an APK is really yours, and
# anyone holding it can publish something that claims to be this app.
#
# The keystore itself belongs somewhere backed up and off this machine. If it
# is lost, an update can never be installed over an existing copy of the app:
# Android refuses an APK signed by a different key.
storeFile=C:\\path\\to\\balloons.jks
storePassword=
keyAlias=balloons
keyPassword=
